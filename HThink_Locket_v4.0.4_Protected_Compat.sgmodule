#!name=HThink Locket • Looks 60s Mic • v4.0.4 P1
#!desc=Compatibility test: uses locally mirrored Cuios v4.0.4 Protected P1, not the rebuilt v4.0.5 runtime. One Locket module at a time. No proof of Gold or native upload.
#!author=HThink (Cuios source; preserve original LICENSE)
#!moduleUrl=https://raw.githubusercontent.com/thinkiutram/HThink-locket-module/main/HThink_Locket_v4.0.4_Protected_Compat.sgmodule

[Script]
cuios4_status = type=http-request, pattern=^http://cuios-status\.invalid/(?:status|report\.json)(?:\?[^#]*)?$, script-path=https://raw.githubusercontent.com/thinkiutram/HThink-locket-module/main/scripts/protected/locket-v4.0.4-15f350254cfd.js, timeout=10
cuios4_https = type=http-request, pattern=^https://(?:api\.revenuecat\.com|firebaseremoteconfig\.googleapis\.com)/cuios-check(?:\?[^#]*)?$, script-path=https://raw.githubusercontent.com/thinkiutram/HThink-locket-module/main/scripts/protected/locket-v4.0.4-15f350254cfd.js, timeout=10
cuios4_request = type=http-request, pattern=^https://(?:(?:api\.revenuecat\.com|api\.rc-backup\.com|api-production\.8-lives-cat\.io)/(?:v1|v2)/(?:receipts|subscribers)(?:[/?]|$)|firebaseremoteconfig\.googleapis\.com/v1/projects/[^/?#]+/namespaces/[^/?#]+:fetch/?(?:\?[^#]*)?$), script-path=https://raw.githubusercontent.com/thinkiutram/HThink-locket-module/main/scripts/protected/locket-v4.0.4-15f350254cfd.js, timeout=10
cuios4_revenuecat = type=http-response, pattern=^https://(?:api\.revenuecat\.com|api\.rc-backup\.com|api-production\.8-lives-cat\.io)/(?:v1|v2)/(?:receipts|subscribers)(?:[/?]|$), script-path=https://raw.githubusercontent.com/thinkiutram/HThink-locket-module/main/scripts/protected/locket-v4.0.4-15f350254cfd.js, requires-body=true, max-size=1048576, timeout=10
cuios4_firebase = type=http-response, pattern=^https://firebaseremoteconfig\.googleapis\.com/v1/projects/(?:locket-4252a|869942740286)/namespaces/firebase:fetch/?(?:\?[^#]*)?$, script-path=https://raw.githubusercontent.com/thinkiutram/HThink-locket-module/main/scripts/protected/locket-v4.0.4-15f350254cfd.js, argument=looks-aura-frame, requires-body=true, max-size=1048576, timeout=10

[Host]
cuios-status.invalid = 198.18.0.1

[MITM]
hostname = %APPEND% api.revenuecat.com, api.rc-backup.com, api-production.8-lives-cat.io, firebaseremoteconfig.googleapis.com
